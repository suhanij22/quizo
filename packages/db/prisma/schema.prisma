// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum QuizStatus{
  DRAFT
  ACTIVE
  COMPLETED
}

enum Difficulty{
  EASY
  MEDIUM
  HARD
}

enum SessionStatus{
  WAITING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model User {
  id       String  @id @default(uuid())
  email    String  @unique
  password String
  name     String
  photo    String?
  createdAt DateTime @default(now())
  quizzes Quiz[]
  participants Participant[]
}

model Quiz{
  id String @id @default(uuid())
  title String
  description String?
  createdAt DateTime @default(now())
  creatorId String
  creator User @relation(fields: [creatorId],references: [id],onDelete: Cascade)
  questions Question[]
  quizSessions QuizSession[]
}

model Question{
  id String @id @default(uuid())
  text String 
  timeLimit Int @default(15)
  order Int
  difficulty Difficulty @default(EASY)
  quizId String
  quiz Quiz @relation(fields: [quizId], references: [id],onDelete:Cascade)
  options Option[]
  participantAnswers ParticipantAnswer[]
}

model Option{
  id String @id @default(uuid())
  text String
  isCorrect Boolean @default(false)
  questionId String
  question Question @relation(fields: [questionId],references: [id],onDelete: Cascade)
  participantAnswers ParticipantAnswer[]
}

model QuizSession{
  id String @id @default(uuid())
  currentQuestionIndex Int @default(0)
  status SessionStatus @default(WAITING)
  joinCode String @unique
  startedAt DateTime?
  endedAt DateTime?
  createdAt DateTime @default(now())
  quizId String
  quiz Quiz @relation(fields: [quizId],references: [id],onDelete: Cascade)
  participants Participant[]
}

model Participant {
  id String @id @default(uuid())
  username String
  score Int @default(0)
  joinedAt DateTime @default(now())
  sessionId String
  session QuizSession @relation(fields: [sessionId],references: [id],onDelete: Cascade)
  userId String?  //a parrticipant can be registered user or just to play a quiz using username
  user User? @relation(fields: [userId],references: [id],onDelete: Cascade)
  answers ParticipantAnswer[]

  //no two usernames can be same
  @@unique([sessionId,username])
}

model ParticipantAnswer{
  id String @id @default(uuid())
  timeTook Int
  isCorrect Boolean
  points Int @default(0)
  createdAt DateTime @default(now())
  participantId String
  participant Participant @relation(fields: [participantId],references: [id],onDelete: Cascade)
  questionId String
  question Question @relation(fields: [questionId],references: [id],onDelete: Cascade)
  optionId String
  option Option @relation(fields: [optionId],references: [id])

  //a player can only answer one time 
  @@unique([participantId,questionId])
}